#!/usr/bin/env bash
# Wire WorkerBees scope governance into a project so every agent obeys it.
#
#   wb-init [project-path] [--hosts claude,codex,cursor,antigravity] [--wip-limit N]
#
# Idempotent and non-destructive: existing files are never overwritten, and an
# existing commit-msg hook is backed up before replacement.
set -euo pipefail

PKG=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
project=""
hosts="claude,codex,cursor,antigravity"
wip=5

while [ "$#" -gt 0 ]; do
    case "$1" in
        --hosts) hosts=${2:?--hosts requires a value}; shift 2 ;;
        --wip-limit) wip=${2:?--wip-limit requires a value}; shift 2 ;;
        -h|--help) sed -n '2,8p' "$0"; exit 0 ;;
        -*) printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
        *) project=$1; shift ;;
    esac
done
[ -n "$project" ] || project=$(pwd)
project=$(CDPATH= cd -- "$project" && pwd)
git -C "$project" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || { printf 'error: not a git work tree: %s\n' "$project" >&2; exit 2; }

say() { printf '  %s\n' "$*"; }
printf 'wb-init  %s\n' "$project"

# 1. Templates -- never overwrite an existing file.
for tpl in REQUIREMENTS.md BACKLOG.md; do
    if [ -e "$project/$tpl" ]; then
        say "kept existing $tpl"
    else
        cp "$PKG/templates/$tpl" "$project/$tpl"
        say "created $tpl"
    fi
done

# 2. commit-msg hook -- the one mechanism every host obeys.
# Resolve the real hook directory: honour core.hooksPath, and handle worktrees
# where .git is a file and hooks live in the shared common directory.
hookdir=$(git -C "$project" config --get core.hooksPath 2>/dev/null || true)
if [ -z "$hookdir" ]; then
    hookdir=$(git -C "$project" rev-parse --git-path hooks)
fi
case "$hookdir" in
    /*) ;;
    *) hookdir="$project/$hookdir" ;;
esac
mkdir -p "$hookdir"
if [ "$(git -C "$project" rev-parse --git-common-dir)" != "$(git -C "$project" rev-parse --git-dir)" ]; then
    say "note: this is a worktree; the hook is shared with every worktree of this repository"
fi
if [ -e "$hookdir/commit-msg" ] && ! grep -q 'WorkerBees commit-msg hook' "$hookdir/commit-msg" 2>/dev/null; then
    cp "$hookdir/commit-msg" "$hookdir/commit-msg.pre-workerbees"
    say "backed up existing commit-msg to commit-msg.pre-workerbees"
fi
cp "$PKG/scripts/commit-msg" "$hookdir/commit-msg"
chmod +x "$hookdir/commit-msg"
say "installed ${hookdir#$project/}/commit-msg"

# 3. Agent instructions -- AGENTS.md covers Codex/Cursor/Antigravity, CLAUDE.md Claude Code.
for doc in AGENTS.md CLAUDE.md; do
    if [ -f "$project/$doc" ] && grep -q 'Scope governance (non-negotiable)' "$project/$doc"; then
        say "kept $doc (already governed)"
    else
        printf '\n' >> "$project/$doc"
        cat "$PKG/templates/AGENTS.md.snippet" >> "$project/$doc"
        say "appended scope governance to $doc"
    fi
done

# 4. SessionStart reminder per host.
# When the package lives inside the project being wired, record the command
# relative to the project root. Host config files are routinely committed, and
# an absolute path is correct on exactly one machine -- every other clone gets a
# command that cannot exist, and the repository publishes its author's directory
# layout. Outside the project, absolute is the only thing that resolves.
remind="$PKG/scripts/wb-remind"
if [ "$PKG" = "$project" ]; then
    remind="./scripts/wb-remind"
else
    # Use the strip itself as the test: it only changes the string when PKG is
    # genuinely below project. A glob like "$project"/* also matches when the
    # two are equal (* matches empty), which would leave the strip a no-op and
    # emit "./" prepended to a full absolute path.
    rel=${PKG#"$project"/}
    if [ "$rel" != "$PKG" ]; then
        remind="./$rel/scripts/wb-remind"
    fi
fi
IFS=',' read -r -a host_list <<< "$hosts"
for host in "${host_list[@]}"; do
    case "$host" in
        claude)
            mkdir -p "$project/.claude"
            python3 - "$project/.claude/settings.json" "$remind" <<'PY'
import json, os, sys
path, remind = sys.argv[1], sys.argv[2]
data = {}
if os.path.isfile(path):
    try:
        data = json.load(open(path))
    except (ValueError, OSError):
        data = {}
if not isinstance(data, dict):
    data = {}

# Ours means a bare invocation of the script, under whatever path an earlier
# install used -- matching the exact current path would strand those and a
# re-run would duplicate rather than update. A command that merely *mentions*
# wb-remind (a wrapper, a logger, a conditional) is a deliberate customisation
# belonging to somebody else, and these entries get replaced, so a loose match
# would delete their work.
def _commands(node):
    if isinstance(node, dict):
        for key, value in node.items():
            if key == "command" and isinstance(value, str):
                yield value
            else:
                yield from _commands(value)
    elif isinstance(node, list):
        for value in node:
            yield from _commands(value)

def is_ours(entry):
    return any(c == "wb-remind" or c.endswith("/wb-remind")
               for c in _commands(entry))

hooks = data.setdefault("hooks", {})
if not isinstance(hooks, dict):
    hooks = data["hooks"] = {}
entries = hooks.setdefault("SessionStart", [])
if not isinstance(entries, list):
    entries = hooks["SessionStart"] = []
entries[:] = [e for e in entries if not is_ours(e)]
entries.append({"hooks": [{"type": "command", "command": remind}]})
json.dump(data, open(path, "w"), indent=2)
PY
            say "wired Claude Code SessionStart (.claude/settings.json)"
            ;;
        cursor)
            mkdir -p "$project/.cursor"
            python3 - "$project/.cursor/hooks.json" "$remind" <<'PY'
import json, os, sys
path, remind = sys.argv[1], sys.argv[2]
data = {"version": 1, "hooks": {}}
if os.path.isfile(path):
    try:
        data = json.load(open(path))
    except (ValueError, OSError):
        pass
if not isinstance(data, dict):
    data = {"version": 1, "hooks": {}}
data.setdefault("version", 1)

# Ours means a bare invocation of the script, under whatever path an earlier
# install used -- matching the exact current path would strand those and a
# re-run would duplicate rather than update. A command that merely *mentions*
# wb-remind (a wrapper, a logger, a conditional) is a deliberate customisation
# belonging to somebody else, and these entries get replaced, so a loose match
# would delete their work.
def _commands(node):
    if isinstance(node, dict):
        for key, value in node.items():
            if key == "command" and isinstance(value, str):
                yield value
            else:
                yield from _commands(value)
    elif isinstance(node, list):
        for value in node:
            yield from _commands(value)

def is_ours(entry):
    return any(c == "wb-remind" or c.endswith("/wb-remind")
               for c in _commands(entry))

hooks = data.setdefault("hooks", {})
if not isinstance(hooks, dict):
    hooks = data["hooks"] = {}
entries = hooks.setdefault("sessionStart", [])
if not isinstance(entries, list):
    entries = hooks["sessionStart"] = []
entries[:] = [e for e in entries if not is_ours(e)]
entries.append({"command": remind})
json.dump(data, open(path, "w"), indent=2)
PY
            say "wired Cursor sessionStart (.cursor/hooks.json)"
            ;;
        antigravity)
            mkdir -p "$project/.agents"
            python3 - "$project/.agents/hooks.json" "$remind" <<'PY'
import json, os, sys
path, remind = sys.argv[1], sys.argv[2]
data = {}
if os.path.isfile(path):
    try:
        data = json.load(open(path))
    except (ValueError, OSError):
        data = {}
if not isinstance(data, dict):
    data = {}

# Ours means a bare invocation of the script, under whatever path an earlier
# install used -- matching the exact current path would strand those and a
# re-run would duplicate rather than update. A command that merely *mentions*
# wb-remind (a wrapper, a logger, a conditional) is a deliberate customisation
# belonging to somebody else, and these entries get replaced, so a loose match
# would delete their work.
def _commands(node):
    if isinstance(node, dict):
        for key, value in node.items():
            if key == "command" and isinstance(value, str):
                yield value
            else:
                yield from _commands(value)
    elif isinstance(node, list):
        for value in node:
            yield from _commands(value)

def is_ours(entry):
    return any(c == "wb-remind" or c.endswith("/wb-remind")
               for c in _commands(entry))

entries = data.setdefault("PreInvocation", [])
if not isinstance(entries, list):
    entries = data["PreInvocation"] = []
entries[:] = [e for e in entries if not is_ours(e)]
entries.append({"type": "command", "command": remind})
json.dump(data, open(path, "w"), indent=2)
PY
            say "wired Antigravity PreInvocation (.agents/hooks.json)"
            ;;
        codex)
            mkdir -p "$project/.codex"
            # Merge, never truncate: an existing hooks.json may carry unrelated
            # blocks that are none of our business. Nesting under "hooks" matches
            # the shape observed in a real Codex project, alongside PostToolUse
            # and Stop -- the same shape Claude Code uses.
            python3 - "$project/.codex/hooks.json" "$remind" <<'PY'
import json, os, sys
path, remind = sys.argv[1], sys.argv[2]
data = {}
if os.path.isfile(path):
    try:
        data = json.load(open(path))
    except (ValueError, OSError):
        data = {}
if not isinstance(data, dict):
    data = {}

# Ours means a bare invocation of the script, under whatever path an earlier
# install used -- matching the exact current path would strand those and a
# re-run would duplicate rather than update. A command that merely *mentions*
# wb-remind (a wrapper, a logger, a conditional) is a deliberate customisation
# belonging to somebody else, and these entries get replaced, so a loose match
# would delete their work.
def _commands(node):
    if isinstance(node, dict):
        for key, value in node.items():
            if key == "command" and isinstance(value, str):
                yield value
            else:
                yield from _commands(value)
    elif isinstance(node, list):
        for value in node:
            yield from _commands(value)

def is_ours(entry):
    return any(c == "wb-remind" or c.endswith("/wb-remind")
               for c in _commands(entry))

# An older wb-init wrote SessionStart at the top level. Reclaim only the
# entries that are ours; anything else there is somebody else's and stays
# exactly where they put it.
legacy = data.get("SessionStart")
if isinstance(legacy, list):
    foreign = [e for e in legacy if not is_ours(e)]
    if len(foreign) != len(legacy):
        if foreign:
            data["SessionStart"] = foreign
        else:
            data.pop("SessionStart", None)

hooks = data.setdefault("hooks", {})
if not isinstance(hooks, dict):
    hooks = data["hooks"] = {}
entries = hooks.setdefault("SessionStart", [])
if not isinstance(entries, list):
    entries = hooks["SessionStart"] = []
entries[:] = [e for e in entries if not is_ours(e)]
entries.append({"hooks": [{"command": remind}]})
json.dump(data, open(path, "w"), indent=2)
PY
            say "wired Codex SessionStart (.codex/hooks.json) -- verify against your Codex version"
            ;;
        *) printf '  warning: unknown host %s (skipped)\n' "$host" >&2 ;;
    esac
done

cat <<MSG

  Next:
    1. Edit REQUIREMENTS.md. Freeze a SMALL set -- five, not twenty-five.
    2. Commit it, then record that commit sha in the "Frozen at:" field.
    3. Put everything else in BACKLOG.md.
    4. Check progress any time:
         python3 $PKG/scripts/wb_trace.py "$project" --wip-limit $wip
MSG
